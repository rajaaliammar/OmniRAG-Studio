# OmniRAG Studio — environment template
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Local embeddings (default). No OpenAI key required.
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional: set EMBEDDING_PROVIDER=openai and a real key to use OpenAI instead.
# To use OpenAI only if local embeddings fail, set:
# EMBEDDING_FALLBACK_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here

CHROMA_DB_PATH=./chroma_db
DATABASE_URL=sqlite:///./analytics.db
DEFAULT_COLLECTION_NAME=default_collection
LOG_LEVEL=INFO
